{
  "http_server": {
    "port": 8000
  },
  "log": {
    "level": "info"
  },
  "client": {
    "allowed_origins": [
      "https://<spa-host>"
    ],
    "disallow_anonymous_connection_tokens": true,
    "token": {}
  },
  "http_api": {
    "key": ""
  },
  "channel": {
    "without_namespace": {
      "allow_subscribe_for_client": true,
      "presence": true,
      "join_leave": true
    },
    "namespaces": [
      {
        "name": "group",
        "allow_subscribe_for_client": false,
        "presence": true,
        "join_leave": true,
        "history_size": 100,
        "history_ttl": "300s"
      },

      {
        "name": "user",
        "allow_subscribe_for_client": false,
        "presence": true,
        "join_leave": true,
        "history_size": 100,
        "history_ttl": "300s"
      }
    ]
  },
  "admin": {
    "enabled": false
  },
  "health": {
    "enabled": true
  },
  "prometheus": {
    "enabled": true
  }
}
