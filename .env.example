# ============================================================================
# Centrifugo × OAuth 2.0 stack — environment variables (SAMPLE)
#
# Copy to `.env` and fill in real values:  cp .env.example .env
# `.env` is git-ignored — real secrets live only there.
#
# MANDATORY MODE SWITCH: exactly ONE Centrifugo connection-auth mode may be
# active. The .env configures BOTH the App API (how it dispenses connection
# tokens) and Centrifugo (which signature it accepts). Keep them in agreement.
# ============================================================================

# ----------------------------------------------------------------------------
# MODE A · "azure pub-sub" (default) — brokered by the proxy sidecar
#   The SPA logs in with OAuth (the app server verifies that login), then the
#   proxy sidecar ON THE CENTRIFUGO SIDE mints a short-lived HS256
#   connection JWT — the Web PubSub "client access token / negotiate" pattern.
# ----------------------------------------------------------------------------
CONNECTION_TOKEN_MODE=hmac
# Shared secret — known ONLY to the proxy sidecar and Centrifugo.
# 32+ random bytes: openssl rand -hex 32
CENTRIFUGO_TOKEN_HMAC_SECRET=<openssl rand -hex 32>
# Lifetime of minted connection JWTs (seconds).
CONNECTION_TTL=300
# App-level session (offline lab demo only). 32+ bytes; change for production.
SESSION_SECRET=<openssl rand -hex 32>
SESSION_TTL=28800
# MODE A inactive — leave EMPTY/COMMENTED in this mode:
#CENTRIFUGO_JWKS_URL_OVERRIDE=
#CENTRIFUGO_TOKEN_ISSUER_OVERRIDE=
#CENTRIFUGO_TOKEN_AUDIENCE_OVERRIDE=

# ----------------------------------------------------------------------------
# MODE B · IdP-verified (inactive) — Centrifugo verifies OAuth tokens directly
#   Uncomment overrides below and comment MODE A lines to activate.
#   Centrifugo then validates signature (RS256/JWKS), issuer and audience.
# ----------------------------------------------------------------------------
#CONNECTION_TOKEN_MODE=oauth
#CENTRIFUGO_JWKS_URL_OVERRIDE=https://auth.example.com/api/.well-known/jwks.json
#CENTRIFUGO_TOKEN_ISSUER_OVERRIDE=https://auth.example.com/api
#CENTRIFUGO_TOKEN_AUDIENCE_OVERRIDE=ws-server

# ----------------------------------------------------------------------------
# OAuth login (always used for the App API control plane, both modes)
# ----------------------------------------------------------------------------
AUTH_ISSUER=https://auth.example.com/api
AUTH_JWKS_URL=https://auth.example.com/api/.well-known/jwks.json
AUTH_AUTHORIZE_URL=https://auth.example.com/api/authorize
AUTH_TOKEN_URL=https://auth.example.com/api/token
# Public (no-secret) client for the SPA's authorization-code + PKCE login.
AUTH_CLIENT_ID=ws-server
# comma-list allowed: user tokens aud=ws-server, M2M tokens aud=<client_id>
AUTH_AUDIENCE=ws-server,<m2m-client-id>
# (Optional) secret if ws-server is confidential (client_secret_post).
AUTH_CLIENT_SECRET=
# ── App server's M2M service identity — SEPARATE OAuth client ──
AUTH_SERVICE_CLIENT_ID=<m2m-client-id>
# Secret for the M2M client's client_credentials grant.
AUTH_SERVICE_CLIENT_SECRET=<client-secret>
# Scopes the App server requests for its own service token.
AUTH_SERVICE_SCOPES=api://ws-server/app:publisher
# OAuth client-id allow-list (defense-in-depth, App API): tokens must have
# been issued to one of these clients (client_id / azp claim). Empty = off.
ALLOWED_CLIENT_IDS=ws-server,<m2m-client-id>
# Scopes requested by the SPA during authorization-code + PKCE flow.
# NOTE: the admission policy is token-validation-only (no scope needed to
# watch); api://ws-server/app:publisher is required ONLY to publish.
AUTH_REQUESTED_SCOPES=openid profile email api://ws-server/app:publisher
# Where the IdP bounces back after login — must be registered on ws-server.
AUTH_REDIRECT_URI=http://localhost:3000/callback

# --- proxy sidecar (the Centrifugo-side wall) ---------------------------
# Holds the ONLY X-API-Key; OAuth-validates every caller and proxies the
# Centrifugo Server API. No ports published — compose-network only.
CENTRIFUGO_HTTP_API_KEY=<openssl rand -hex 32>

# --- Centrifugo server --------------------------------------------------------
# Debug logging while wiring up; drop to info for real deployments.
CENTRIFUGO_LOG_LEVEL=info

# --- App API ------------------------------------------------------------------
APP_PORT=3000
REQUIRED_CLAIMS=sub,exp,iat,nbf,iss,aud
# Admission scope floor: EMPTY by default — token validation only (authN).
# Publishing is authorization-lane-gated by PUBLISH_REQUIRED_SCOPE instead.
# Set a comma-list here to impose a blanket floor on everything.
REQUIRED_SCOPES=
# OAuth scope required for ANY publication into Centrifugo (both lanes).
# Azure-style URI: api/<audience>/<resource>:<action> — the IdP must grant
# api://ws-server/app:publisher to the calling clients (ws-server for users,
# the M2M client for the service identity).
PUBLISH_REQUIRED_SCOPE=api://ws-server/app:publisher
# OAuth scope required to SHAPE a mint (body sub/channels/subs on
# /realtime/token — server-side subscriptions, i.e. group membership).
# Default = PUBLISH_REQUIRED_SCOPE: grant it to the app server's M2M
# identity only, NEVER to the public SPA client (browsers must not
# self-select groups).
#MINT_SHAPING_SCOPE=api://ws-server/app:publisher
# Max server-side subscriptions one mint may attach.
#MINT_MAX_SUBS=32
# Per-service channel separation (multi-tenant). When set (requires the
# matching namespace in the Centrifugo config — see the `svc` namespace in
# centrifugo/sample), every channel a caller names — relays AND mint
# shaping — must match <prefix>:<its own client_id>:*. Services are then
# fully isolated from each other. Empty = off.
#SERVICE_CHANNEL_PREFIX=svc
# Group channel client_id rewriting. When a caller names a group channel
# (under namespace `group:`, e.g. `group:group-1`), the proxy injects the
# verified client_id (e.g. `app-1`):
#   prepend -> group:app-1,group-1 (default)
#   append  -> group:group-1,app-1
# Applied to both /realtime/token minting (channels/subs) and Server-API relays.
#GROUP_CLIENT_ID_POSITION=prepend
#GROUP_CLIENT_ID_DELIMITER=,
CENTRIFUGO_PUBLIC_WS_URL=ws://localhost:8000/connection/websocket
DEMO_CHANNEL=chat

# --- Mock fallback IdP (optional, dev-only) ------------------------------------
# The mock stays available so you can demo the stack offline; to use it
# instead of the real IdP, temporarily override (see docker-compose.yml):
#   AUTH_ISSUER=https://auth.example.com/realms/demo \
#   AUTH_AUDIENCE=centrifugo \
#   AUTH_JWKS_URL=http://auth-server:9001/realms/demo/.well-known/jwks.json \
AUTH_PORT=9001
